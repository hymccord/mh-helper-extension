{
  "name": "mhct-helper-extension",
  "version": "1.0.0",
  "description": "Dev environment for the MHCT browser extension",
  "homepage": "https://github.com/mh-community-tools/mh-helper-extension#readme",
  "license": "MIT",
  "keywords": [
    "mousehunt"
  ],
  "author": {
    "name": "DevJackSmith",
    "url": "https://github.com/DevJackSmith/"
  },
  "maintainers": [
    {
      "name": "AardWolf",
      "url": "https://github.com/AardWolf/"
    },
    {
      "name": "DevJackSmith",
      "url": "https://github.com/DevJackSmith/"
    },
    {
      "name": "tehhowch",
      "url": "https://github.com/tehhowch/"
    },
    {
      "name": "tsitu",
      "url": "https://github.com/tsitu/"
    },
    {
      "name": "hymccord",
      "url": "https://github.com/hymccord/"
    }
  ],
  "bugs": {
    "url": "https://github.com/mh-community-tools/mh-helper-extension/issues"
  },
  "scripts": {
    "build": "npm run build:chrome",
    "build:watch": "npm run build:watch:chrome",
    "build:chrome": "cross-env BROWSER=chrome vite build --mode development",
    "build:firefox": "cross-env BROWSER=firefox vite build --mode development",
    "build:watch:chrome": "npm run build:chrome -- --watch",
    "build:watch:firefox": "npm run build:firefox -- --watch",
    "build:prod:chrome": "npm run build:chrome -- --mode production",
    "build:prod:firefox": "npm run build:firefox -- --mode production",
    "dev": "npm run dev:chrome",
    "dev:chrome": "npm run build:chrome && concurrently \"npm run start:chrome\" \"npm run build:watch:chrome\"",
    "dev:firefox": "npm run build:firefox && concurrently \"npm run start:firefox\" \"npm run build:watch:firefox\"",
    "start": "npm run start:chrome",
    "start:chrome": "web-ext run --start-url https://www.mousehuntgame.com -t chromium --source-dir dist/chrome",
    "start:firefox": "web-ext run --start-url https://www.mousehuntgame.com --source-dir dist/firefox",
    "lint": "eslint .",
    "lint:webext": "web-ext lint --source-dir dist/firefox --verbose",
    "test": "vitest --run --project=unit",
    "test:e2e": "vitest --run --project=e2e"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mh-community-tools/mh-helper-extension.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mswjs/interceptors": "^0.41.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.1.39",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.5.2",
    "@types/qs": "^6.15.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.14",
    "@webext-core/messaging": "^2.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "jquery": "^4.0.0",
    "mergician": "^2.0.2",
    "nock": "^14.0.12",
    "qs": "^6.15.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.10",
    "vitest-mock-extended": "^4.0.0",
    "web-ext": "^10.1.0",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "fuzzysort": "^3.1.0",
    "rxjs": "^7.8.2",
    "tiny-lru": "^13.0.0",
    "zod": "^4.4.2"
  }
}
